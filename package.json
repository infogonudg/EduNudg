{
  "name": "edunudg",
  "version": "0.0.0",
  "private": true,
  "description": "EduNudg multi-tenant franchise learning OS",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "dev": "pnpm --filter @edunudg/web dev",
    "build": "pnpm --filter @edunudg/web build",
    "build:dev": "pnpm --filter @edunudg/web exec vite build --mode development",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node scripts/assert-workspace-test-bins.mjs && pnpm -r --if-present test",
    "test:rls": "node scripts/run-rls-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local-hosts": "E2E_USE_LOCAL_HOSTS=1 playwright test",
    "ci:local": "node scripts/ci-local.mjs",
    "audit:schema": "node scripts/audit-schema.mjs",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy",
    "functions:deploy:whatsapp": "supabase functions deploy whatsapp-otp",
    "functions:deploy:passkey": "supabase functions deploy passkey-verify",
    "functions:deploy:brand-owner": "supabase functions deploy brand-owner-credentials",
    "franchises:set-default-passwords": "node scripts/set-franchise-default-passwords.mjs",
    "openspec:init": "openspec init --tools cursor",
    "openspec:update": "openspec update"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.8.0",
    "@playwright/test": "^1.62.1",
    "nanoid": "^6.0.1",
    "pg": "^8.22.0",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "happy-dom@<20.0.0": ">=20.0.0",
      "happy-dom@<20.8.9": ">=20.8.9",
      "happy-dom@>=15.10.0 <=20.8.7": ">=20.8.8",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "react-router@>=6.0.0 <7.18.0": ">=7.18.0",
      "react-router@>=7.11.0 <7.18.0": ">=7.18.0",
      "react-router@>=6.4.0 <7.18.0": ">=7.18.0",
      "react-router@>=7.0.0 <7.18.0": ">=7.18.0",
      "react-router@>=7.12.0 <8.3.0": ">=8.3.0",
      "postcss@<=8.5.17": ">=8.5.18",
      "postcss@<=8.5.22": ">=8.5.23",
      "@xmldom/xmldom": ">=0.8.15",
      "source-map-js@<1.2.2": ">=1.2.2",
      "nanoid@^3.0.0": "3.3.18",
      "browserslist@<=4.28.6": ">=4.28.7"
    }
  }
}
