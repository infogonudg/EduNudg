{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/public-seo?file=robots" },
    { "source": "/sitemap.xml", "destination": "/api/public-seo?file=sitemap" },
    { "source": "/llms.txt", "destination": "/api/public-seo?file=llms" },
    { "source": "/.well-known/ai.txt", "destination": "/api/public-seo?file=ai" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/api/seo-document" },
    { "source": "/about", "destination": "/api/seo-document" },
    { "source": "/courses/:slug", "destination": "/api/seo-document" },
    { "source": "/legal/:kind", "destination": "/api/seo-document" },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "master": true,
      "frontendChanges": true
    }
  }
}
